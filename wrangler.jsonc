{
  // dgit: a cgit-style git host that runs entirely on Cloudflare.
  // Each repository lives in its own SQLite-backed Durable Object ("cell").
  // Keep this Worker name stable after the first successful deployment because
  // Durable Object data is scoped to the Worker script.
  "name": "durable-git",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "routes": [
    { "pattern": "git.muyg.cc", "custom_domain": true }
  ],
  // Do not set limits.cpu_ms here: custom CPU limits require Workers Paid.
  // On the Free plan Cloudflare applies its platform default automatically.
  "durable_objects": {
    "bindings": [
      { "name": "REPO", "class_name": "RepoCell" },
      { "name": "REGISTRY", "class_name": "Registry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RepoCell", "Registry"] }
  ],
  // This bucket was created by Wrangler's automatic provisioning on the first
  // deployment attempt. Bind it explicitly now so subsequent CI deploys reuse
  // the existing bucket instead of trying to create it again.
  "r2_buckets": [
    { "binding": "PACK_CACHE", "bucket_name": "durable-git-pack-cache" }
  ],
  "vars": {
    "SITE_NAME": "git.muyg.cc",
    "SITE_DESC": "a fast webinterface for the git dscm, on Cloudflare",
    "SITE_OWNER": "muyg"
  }
  // Push auth: run `wrangler secret put GIT_TOKEN` (use .dev.vars locally).
}
